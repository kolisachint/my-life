#!/bin/sh
# pub - place an artefact using the same Project/Section tree as Todoist.
#
#   Todoist   ⚽️ Goals  >  💲Money  >  task
#   Dropbox   /my-life/Goals/Money/2026-08-27-plan.pdf
#   repo      notes/Goals/Money/plan.md
#
# Folders are created on demand — nothing is pre-built.
#
#   bin/pub plan.html --project Goals --section Money --pdf
#   bin/pub plan.html --task 6h9qvH87vv8638rV --pdf     # infers both from the task
#   bin/pub notes.md  --project Goals --section Career --repo
#   bin/pub draft.html --tmp                            # nowhere; delete after
#
# Destination rule (AGENTS.md):
#   a human reads it     -> Dropbox   (default)
#   memory for next time -> the repo  (--repo)
#   tentative one-off    -> nowhere   (--tmp)
set -e
export PATH="$PATH:$HOME/go/bin"
ROOT=$(cd "$(dirname "$0")/.." && pwd)
[ -f "$ROOT/.env" ] && . "$ROOT/.env"
[ -n "$DROPBOX_ACCESS_TOKEN" ] && export DBXCLI_ACCESS_TOKEN="$DROPBOX_ACCESS_TOKEN"

SRC=""; PROJ=""; SECT=""; TASK=""; PDF=0; TMP=0; REPO=0; LINK=1
while [ $# -gt 0 ]; do
  case "$1" in
    --project) PROJ="$2"; shift ;;
    --section) SECT="$2"; shift ;;
    --task)    TASK="$2"; shift ;;
    --pdf)     PDF=1 ;;
    --tmp)     TMP=1 ;;
    --repo)    REPO=1 ;;
    --no-link) LINK=0 ;;
    -h|--help) sed -n '2,22p' "$0"; exit 0 ;;
    -*)        echo "pub: unknown flag $1" >&2; exit 2 ;;
    *)         SRC="$1" ;;
  esac
  shift
done

[ -n "$SRC" ] || { echo "pub: no file given. try --help" >&2; exit 2; }
[ -f "$SRC" ] || { echo "pub: no such file: $SRC" >&2; exit 2; }

BASE=$(basename "$SRC"); STEM=${BASE%.*}; EXT=${BASE##*.}
STAMP=$(date +%Y-%m-%d)

# Strip emoji and punctuation, keep the name: "⚽️ Goals" -> Goals,
# "✅ Everyday Life" -> Everyday-Life. Same tree, typeable.
slug() {
  printf '%s' "$1" | sed 's/[^[:alnum:] _-]//g; s/^ *//; s/ *$//; s/  */-/g'
}

# --- resolve Project/Section from a task id, if one was given ---------------
if [ -n "$TASK" ]; then
  command -v td >/dev/null 2>&1 || { echo "pub: --task needs the td CLI" >&2; exit 3; }
  eval "$(td task "$TASK" --json </dev/null 2>/dev/null | python3 -c '
import json,sys
try: d=json.load(sys.stdin)
except Exception: sys.exit(0)
if isinstance(d,list): d = d[0] if d else {}
def pick(*keys):
    for k in keys:
        v=d.get(k)
        if isinstance(v,dict): v=v.get("name")
        if isinstance(v,str) and v.strip(): return v.strip()
    return ""
p=pick("projectName","project_name","project")
s=pick("sectionName","section_name","section")
print("PROJ=%s" % json.dumps(p))
print("SECT=%s" % json.dumps(s))
' 2>/dev/null)"
  [ -n "$PROJ" ] || { echo "pub: could not read project/section from task $TASK." >&2
                      echo "     pass --project/--section instead." >&2; exit 3; }
  echo "resolved  $PROJ${SECT:+ / $SECT}"
fi

REL=""
[ -n "$PROJ" ] && REL="$(slug "$PROJ")"
[ -n "$SECT" ] && REL="$REL/$(slug "$SECT")"
[ -z "$REL" ] && REL="_inbox"

# --- render a PDF first, if asked ------------------------------------------
find_chrome() {
  [ -n "$CHROME" ] && [ -x "$CHROME" ] && { echo "$CHROME"; return; }
  for c in /opt/pw-browsers/chromium-*/chrome-linux/chrome \
           /opt/pw-browsers/chromium_headless_shell-*/chrome-linux/headless_shell \
           "/Applications/Google Chrome.app/Contents/MacOS/Google Chrome" \
           "/Applications/Chromium.app/Contents/MacOS/Chromium"; do
    [ -x "$c" ] && { echo "$c"; return; }
  done
  for c in google-chrome chromium chromium-browser microsoft-edge; do
    command -v "$c" >/dev/null 2>&1 && { command -v "$c"; return; }
  done
  return 1
}

WORK=$(mktemp -d); trap 'rm -rf "$WORK"' EXIT
FILES="$SRC"

if [ "$PDF" = 1 ]; then
  case "$EXT" in
    html|htm)
      CHROME=$(find_chrome) || { echo "pub: no Chromium for PDF. set CHROME=/path/to/chrome" >&2; exit 3; }
      ABS=$(cd "$(dirname "$SRC")" && pwd)/$BASE
      "$CHROME" --headless --disable-gpu --no-sandbox --no-pdf-header-footer \
                --print-to-pdf="$WORK/$STEM.pdf" "file://$ABS" >/dev/null 2>&1
      [ -s "$WORK/$STEM.pdf" ] || { echo "pub: PDF render produced nothing" >&2; exit 3; }
      echo "rendered  $STEM.pdf ($(wc -c < "$WORK/$STEM.pdf") bytes)"
      FILES="$SRC $WORK/$STEM.pdf"
      ;;
    *) echo "pub: --pdf applies to HTML only; placing $BASE as-is" >&2 ;;
  esac
fi

# --- tentative: never leaves the machine ------------------------------------
if [ "$TMP" = 1 ]; then
  KEEP=${TMPDIR:-/tmp}/my-life-tmp
  mkdir -p "$KEEP"
  for f in $FILES; do cp "$f" "$KEEP/"; echo "tmp       $KEEP/$(basename "$f")"; done
  echo "not published (--tmp). delete when done: rm -rf $KEEP"
  exit 0
fi

# --- repo: long-term memory -------------------------------------------------
if [ "$REPO" = 1 ]; then
  DEST="$ROOT/notes/$REL"
  mkdir -p "$DEST"
  for f in $FILES; do
    b=$(basename "$f")
    # Re-rendering a source that already lives at the destination is normal:
    # edit notes/<P>/<S>/x.html in place, re-run, get a fresh x.pdf beside it.
    # cp would fail with "same file" and set -e would abort *before* the PDF
    # was copied, silently leaving the old one in place.
    if [ "$f" -ef "$DEST/$b" ]; then
      echo "repo      notes/$REL/$b (already in place)"
    else
      cp "$f" "$DEST/"
      echo "repo      notes/$REL/$b"
    fi
  done
  echo "remember to commit."
  exit 0
fi

# --- Dropbox: human-facing --------------------------------------------------
command -v dbxcli >/dev/null 2>&1 || { echo "pub: dbxcli not installed. run make setup" >&2; exit 3; }

DEST="/my-life/$REL"
# lazy mkdir, one level at a time; already-exists is fine
acc="/my-life"
dbxcli mkdir "$acc" >/dev/null 2>&1 || true
for part in $(printf '%s' "$REL" | tr '/' ' '); do
  acc="$acc/$part"
  dbxcli mkdir "$acc" >/dev/null 2>&1 || true
done

for f in $FILES; do
  n=$(basename "$f")
  target="$DEST/$STAMP-$n"
  dbxcli put "$f" "$target" >/dev/null
  echo "dropbox   $target"
  if [ "$LINK" = 1 ]; then
    url=$(dbxcli share-link create "$target" --output json 2>/dev/null \
          | sed -n 's/.*"url"[ ]*:[ ]*"\([^"]*\)".*/\1/p' | head -1)
    [ -z "$url" ] && url=$(dbxcli share-link create "$target" 2>/dev/null | grep -o 'https://[^ ]*' | head -1)
    [ -n "$url" ] && echo "link      $url"
  fi
done
