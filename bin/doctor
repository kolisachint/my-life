#!/bin/sh
# Delegates to each tool's own diagnostics. Only checks what they don't cover.
export PATH="$PATH:$HOME/go/bin"
ROOT=$(cd "$(dirname "$0")/.." && pwd)
[ -f "$ROOT/.env" ] && . "$ROOT/.env"
[ -n "$DROPBOX_ACCESS_TOKEN" ] && export DBXCLI_ACCESS_TOKEN="$DROPBOX_ACCESS_TOKEN"
ok=0
chk() { printf '%-18s %s\n' "$1" "$2"; }

echo "--- todoist (td doctor) ---"
if command -v td >/dev/null 2>&1; then
  td doctor </dev/null 2>&1 | sed 's/^/  /' || ok=1
else
  chk td "MISSING - run make setup"; ok=1
fi

echo "--- dropbox ---"
if command -v dbxcli >/dev/null 2>&1; then
  chk dbxcli "$(dbxcli version 2>/dev/null | head -1)"
  if dbxcli account >/dev/null 2>&1; then chk "auth" "ok"
  else chk "auth" "not logged in - run 'dbxcli login'"; ok=1; fi
else
  chk dbxcli "MISSING - run make setup"; ok=1
fi

echo "--- this repo ---"
c=""
for p in /opt/pw-browsers/chromium-*/chrome-linux/chrome \
         /opt/pw-browsers/chromium_headless_shell-*/chrome-linux/headless_shell \
         "/Applications/Google Chrome.app/Contents/MacOS/Google Chrome"; do
  [ -x "$p" ] && { c="$p"; break; }
done
[ -z "$c" ] && c=$(command -v google-chrome || command -v chromium || command -v chromium-browser || true)
[ -n "$c" ] && chk "pdf engine" "$c" || chk "pdf engine" "none - bin/pub --pdf will fail"
[ -f "$ROOT/data/brief.md" ] && chk "brief.md" "$(wc -c < "$ROOT/data/brief.md") bytes" \
                             || chk "brief.md" "not generated - run make brief"
chk "memory" "$(grep -vc '^#' "$ROOT/memory/learned.txt" 2>/dev/null || echo 0) facts"
exit $ok
