#!/bin/sh
# Start-of-session brief. Pure filter queries against the upstream todoist CLI -
# no parsing, no invented logic. Todoist's own filter syntax does the work.
set -e
export PATH="$PATH:$HOME/go/bin"
ROOT=$(cd "$(dirname "$0")/.." && pwd)
OUT="$ROOT/data/brief.md"
mkdir -p "$ROOT/data"

command -v todoist >/dev/null 2>&1 || { echo "brief: todoist not installed - run 'make setup'" >&2; exit 3; }
grep -q '"token"[ ]*:[ ]*"[^"]\+"' "$HOME/.config/todoist/config.json" 2>/dev/null || {
  echo "brief: no Todoist token. Put TODOIST_API_TOKEN in .env, then run 'make setup'." >&2
  exit 3; }

# stdin is closed: todoist prompts for a token when one is missing and would
# otherwise block forever inside an agent.
q() { todoist --csv --header --project-namespace list --filter "$1" </dev/null 2>/dev/null \
        | grep -v "^No API token" || true; }

{
  echo "# Brief - $(date +%Y-%m-%d)"
  echo
  echo "_Generated by bin/brief. Regenerate with 'make brief'; do not hand-edit._"
  echo
  echo '## Overdue';      echo; echo '```csv'; q 'overdue';         echo '```'; echo
  echo '## Today';        echo; echo '```csv'; q 'today';           echo '```'; echo
  echo '## Next 7 days';  echo; echo '```csv'; q '7 days & !today'; echo '```'; echo
  echo '## Undated p1';   echo; echo '```csv'; q 'p1 & no date';    echo '```'; echo
  echo "Task detail incl. description: 'todoist show <id>' - one task at a time."
} > "$OUT"

cat "$OUT"
