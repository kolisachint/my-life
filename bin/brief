#!/bin/sh
# One command, one committed snapshot. `td` does all the work; this only
# stitches its output together so a session starts from a single small file.
set -e
export PATH="$PATH:$HOME/go/bin"
ROOT=$(cd "$(dirname "$0")/.." && pwd)
OUT="$ROOT/data/brief.md"
mkdir -p "$ROOT/data"

command -v td >/dev/null 2>&1 || { echo "brief: td not installed - run 'make setup'" >&2; exit 3; }
td auth status >/dev/null 2>&1 || { echo "brief: not authenticated - run 'td auth login'" >&2; exit 3; }

# Default --json is the lean field set; --full would drag in every description.
q() { td $1 --json </dev/null 2>/dev/null || echo '[]'; }

{
  echo "# Brief - $(date +%Y-%m-%d)"
  echo
  echo "_Generated by bin/brief. Regenerate with 'make brief'; do not hand-edit._"
  echo "_Full detail for one task: \`td task <id>\`. Never loop that._"
  echo
  echo '## Today and overdue'; echo; echo '```json'; q 'today';                      echo '```'; echo
  echo '## Next 7 days';       echo; echo '```json'; q 'upcoming';                   echo '```'; echo
  echo '## Undated p1';        echo; echo '```json'; q "task list --filter 'p1 & no date'"; echo '```'
} > "$OUT"

cat "$OUT"
