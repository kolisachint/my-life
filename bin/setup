#!/bin/sh
# Install the tools. Both are official, maintained upstream projects.
# Nothing in this repo reimplements either one.
set -e
export PATH="$PATH:/usr/local/go/bin:$HOME/go/bin"
ROOT=$(cd "$(dirname "$0")/.." && pwd)
have() { command -v "$1" >/dev/null 2>&1; }

# Todoist — official CLI from Doist. Binary is `td`.
# v4 requires Node >=24. On older Node, npm silently resolves to an ancient
# version instead of failing, so check first.
if have node; then
  NODE_MAJOR=$(node -v | sed 's/^v\([0-9]*\).*/\1/')
  [ "$NODE_MAJOR" -lt 24 ] 2>/dev/null && \
    echo "WARNING: Node $(node -v) is below v24. npm will silently install an old td." >&2 && \
    echo "         Upgrade Node, then re-run: npm install -g @doist/todoist-cli@latest" >&2
fi
if have td; then
  echo "td: already installed ($(td --version 2>/dev/null))"
elif have npm; then
  npm install -g @doist/todoist-cli@latest >/dev/null 2>&1 && echo "td: installed via npm ($(td --version 2>/dev/null))"
else
  echo "td: needs npm — install Node, then: npm install -g @doist/todoist-cli" >&2
fi

# Dropbox — official CLI from Dropbox.
if have dbxcli; then
  echo "dbxcli: already installed ($(dbxcli version 2>/dev/null | head -1))"
elif have brew && brew install dbxcli >/dev/null 2>&1; then
  echo "dbxcli: installed via brew"
elif have go && go install github.com/dropbox/dbxcli/v3@latest >/dev/null 2>&1; then
  echo "dbxcli: installed via go install -> \$HOME/go/bin"
else
  echo "dbxcli: install manually from github.com/dropbox/dbxcli/releases" >&2
fi

# LibreOffice Writer — the only way to LOOK at a .docx here. Note that
# libreoffice-core alone is NOT enough: without the writer module soffice fails
# with "source file could not be loaded" on every text document, including a
# plain .txt, which reads like a broken install and is not one. That cost a
# session, and the fix is this one package.
if have soffice && soffice --headless --convert-to pdf --outdir /tmp /dev/null >/dev/null 2>&1; then
  echo "soffice: already working ($(soffice --version 2>/dev/null | head -1))"
elif have apt-get; then
  (apt-get update -qq && apt-get install -y libreoffice-writer) >/dev/null 2>&1 \
    && echo "soffice: installed libreoffice-writer" \
    || echo "soffice: could not install libreoffice-writer - bin/docx --check cannot render" >&2
else
  echo "soffice: install libreoffice-writer to render .docx for review" >&2
fi

# Node packages for the Word builder (docx + an HTML parser).
if have npm && [ -f "$ROOT/notes/Goals/Career/resumes/package.json" ]; then
  (cd "$ROOT/notes/Goals/Career/resumes" && npm install --silent --no-audit --no-fund) >/dev/null 2>&1 \
    && echo "docx builder: node deps installed"
fi

# Doist ships an official agent skill describing the whole td surface.
if have td; then
  td skill install claude-code --local --force >/dev/null 2>&1 \
    && echo "td: official claude-code skill installed to .claude/skills/todoist-cli/"
fi

echo
echo "Then authenticate:"
echo "  td auth login        # or: export TODOIST_API_TOKEN=... for headless"
echo "  dbxcli login"
echo "  make doctor"
