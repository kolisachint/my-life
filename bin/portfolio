#!/bin/sh
# portfolio - refresh the open-source inventory that the career documents cite.
#
#   bin/portfolio                 # refresh notes/Goals/Career/portfolio.md
#   bin/portfolio --list          # just show what is tracked
#
# Repos are listed in data/portfolio-repos.txt, one "owner/name" per line.
# To discover new ones, an agent should call the claude-code-remote
# `list_repos` MCP tool — the plain GitHub API is blocked here ("sessions are
# bound to their configured repositories"), so enumeration cannot be scripted.
# Per-repo reads DO work: the git proxy serves anonymous clones of public repos.
set -e
ROOT=$(cd "$(dirname "$0")/.." && pwd)
LIST="$ROOT/data/portfolio-repos.txt"
CACHE="${TMPDIR:-/tmp}/portfolio-cache"
OUT="$ROOT/notes/Goals/Career/portfolio.md"

[ -f "$LIST" ] || { echo "portfolio: missing $LIST" >&2; exit 2; }

if [ "$1" = "--list" ]; then grep -v '^\s*#' "$LIST" | grep -v '^\s*$'; exit 0; fi

mkdir -p "$CACHE"
{
  echo "# Open-source portfolio"
  echo
  echo "_Generated by \`bin/portfolio\` on $(date +%Y-%m-%d). Do not hand-edit —"
  echo "edit \`data/portfolio-repos.txt\` and re-run._"
  echo
  echo "This is the evidence behind the **AI** half of his Data & AI positioning."
  echo "Before claiming he lacks proof of anything, read this file."
  echo
} > "$OUT"

grep -v '^\s*#' "$LIST" | grep -v '^\s*$' | while read -r repo; do
  name=$(basename "$repo")
  dir="$CACHE/$name"
  if [ -d "$dir/.git" ]; then
    git -C "$dir" fetch --depth 1 origin HEAD >/dev/null 2>&1 || true
    git -C "$dir" reset --hard FETCH_HEAD >/dev/null 2>&1 || true
  else
    GIT_LFS_SKIP_SMUDGE=1 git clone --depth 1 "https://github.com/$repo" "$dir" >/dev/null 2>&1 \
      || { echo "portfolio: could not clone $repo" >&2; continue; }
  fi

  langs=""
  for ext in rs ts tsx py go; do
    n=$(find "$dir" -name "*.$ext" -not -path '*/node_modules/*' -not -path '*/target/*' 2>/dev/null | wc -l | tr -d ' ')
    [ "$n" -gt 0 ] && langs="$langs $ext:$n"
  done
  last=$(git -C "$dir" log -1 --format='%ad' --date=short 2>/dev/null)

  {
    echo "## $name"
    echo
    echo "\`github.com/$repo\` · last push $last ·${langs:- —} (source files by extension)"
    echo
    # First real prose paragraph of the README. Skips headings, badges, and HTML
    # blocks — note the leading-whitespace trim first, or an indented <img>
    # inside a centred <picture> block sails straight through.
    awk '
      { line = $0; sub(/^[[:space:]]+/, "", line) }
      line ~ /^<|^<\// { next }
      line ~ /^!\[|^\[!\[/ { next }
      line ~ /^#/ { next }
      line ~ /^-{3,}$/ { next }
      line == "" { if (got) exit; next }
      { print line; got=1 }
    ' "$dir/README.md" 2>/dev/null | head -6
    echo
  } >> "$OUT"
  echo "portfolio  $repo"
done

echo
echo "wrote     ${OUT#$ROOT/}"
echo "remember to commit."
