#!/usr/bin/env python3
"""
todoist — zero-dependency Todoist CLI for the my-life repo.

Python 3.8+ stdlib only. No pip, no node, no MCP server. Works identically
under Claude Code, OpenCode, Codex, Cursor, or a bare terminal.

Why this exists: reading tasks through an MCP server costs ~40k tokens per
session because every task drags its full description along. This syncs once
over HTTP and writes small derived views that an agent can read for ~2k.

Auth:  export TODOIST_API_TOKEN=...   (Todoist → Settings → Integrations → Developer)

Usage:
  todoist sync [--full]        Pull changes into data/ (incremental by default)
  todoist brief [--days N]     Print the compact agent brief
  todoist ls [--overdue] [--today] [--days N] [--project P] [--label L] [--pri N] [--search TEXT]
  todoist show ID...           Full task detail incl. description
  todoist add "text" [--due D] [--pri N] [--project P] [--section S] [--parent ID] [--label L] [--desc TEXT]
  todoist done ID...           Close task(s) — advances recurring ones
  todoist resched ID DUE       Reschedule; refuses to silently drop a recurrence
  todoist pri ID N             Set priority 1..4 (1 = highest, matches the UI)
  todoist rm ID...             Delete task(s)
  todoist projects             List projects and sections with IDs
  todoist doctor               Check env, token, connectivity, cache freshness
"""

import argparse
import json
import os
import ssl
import sys
import time
import urllib.error
import urllib.parse
import urllib.request
from datetime import datetime, timedelta, timezone

API = "https://api.todoist.com/api/v1"
ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
DATA = os.path.join(ROOT, "data")
NOTES = os.path.join(DATA, "notes")
STORE = os.path.join(DATA, "store.json")
TOKENF = os.path.join(DATA, ".sync_token")

RESOURCES = ["items", "projects", "sections", "labels", "user"]

# Todoist stores priority inverted: API 4 == UI p1 (highest).
API2UI = {4: 1, 3: 2, 2: 3, 1: 4}
UI2API = {1: 4, 2: 3, 3: 2, 4: 1}


# ---------------------------------------------------------------- utilities

def die(msg, code=1):
    print("todoist: " + msg, file=sys.stderr)
    sys.exit(code)


def token():
    t = os.environ.get("TODOIST_API_TOKEN") or os.environ.get("TODOIST_API_KEY")
    if not t:
        envf = os.path.join(ROOT, ".env")
        if os.path.exists(envf):
            with open(envf) as fh:
                for line in fh:
                    line = line.strip()
                    if line.startswith("TODOIST_API_TOKEN="):
                        t = line.split("=", 1)[1].strip().strip("'\"")
                        break
    if not t:
        die("no API token. export TODOIST_API_TOKEN=... or add it to .env "
            "(Todoist → Settings → Integrations → Developer).")
    return t


def post(path, fields):
    body = urllib.parse.urlencode(fields).encode()
    req = urllib.request.Request(
        API + path,
        data=body,
        headers={
            "Authorization": "Bearer " + token(),
            "Content-Type": "application/x-www-form-urlencoded",
            "User-Agent": "my-life-cli/1.0",
        },
    )
    ctx = ssl.create_default_context()  # honours SSL_CERT_FILE if set
    for attempt in range(4):
        try:
            with urllib.request.urlopen(req, context=ctx, timeout=60) as r:
                return json.loads(r.read().decode())
        except urllib.error.HTTPError as e:
            detail = e.read().decode("utf-8", "replace")[:400]
            if e.code == 401:
                die("401 unauthorized — the API token is wrong or revoked.")
            if e.code == 429 or e.code >= 500:
                if attempt < 3:
                    time.sleep(2 ** attempt)
                    continue
            die("HTTP %s from %s\n%s" % (e.code, path, detail))
        except urllib.error.URLError as e:
            if attempt < 3:
                time.sleep(2 ** attempt)
                continue
            die("network error: %s" % e.reason)
    die("unreachable")


def load_store():
    if not os.path.exists(STORE):
        return {"items": {}, "projects": {}, "sections": {}, "labels": {}, "user": {}}
    with open(STORE) as fh:
        return json.load(fh)


def save_store(store):
    os.makedirs(DATA, exist_ok=True)
    tmp = STORE + ".tmp"
    with open(tmp, "w") as fh:
        json.dump(store, fh, indent=1, sort_keys=True, ensure_ascii=False)
    os.replace(tmp, STORE)


def today():
    return datetime.now().date()


def due_date(item):
    d = (item.get("due") or {}).get("date")
    if not d:
        return None
    return d[:10]


def pri_ui(item):
    return API2UI.get(item.get("priority", 1), 4)


# ------------------------------------------------------------------- sync

def cmd_sync(args):
    store = load_store()
    stoken = "*"
    if not args.full and os.path.exists(TOKENF):
        with open(TOKENF) as fh:
            stoken = fh.read().strip() or "*"

    res = post("/sync", {
        "sync_token": stoken,
        "resource_types": json.dumps(RESOURCES),
    })

    full = res.get("full_sync", stoken == "*")
    if full:
        for k in ("items", "projects", "sections", "labels"):
            store[k] = {}

    changed = 0
    for key in ("items", "projects", "sections", "labels"):
        for obj in res.get(key) or []:
            oid = str(obj.get("id"))
            if obj.get("is_deleted"):
                store[key].pop(oid, None)
            else:
                store[key][oid] = obj
            changed += 1
    if res.get("user"):
        store["user"] = res["user"]

    store["synced_at"] = datetime.now(timezone.utc).isoformat(timespec="seconds")
    save_store(store)

    with open(TOKENF, "w") as fh:
        fh.write(res.get("sync_token", "*"))

    render_all(store)
    kind = "full" if full else "incremental"
    print("synced (%s): %d objects changed, %d active tasks"
          % (kind, changed, len([i for i in store["items"].values() if not i.get("checked")])))


# ---------------------------------------------------------------- rendering

def render_all(store):
    """Regenerate every derived view from the local store. No network."""
    os.makedirs(NOTES, exist_ok=True)
    projects = store["projects"]
    sections = store["sections"]

    def pname(pid):
        p = projects.get(str(pid or ""), {})
        return p.get("name", "Inbox" if p.get("inbox_project") else "-")

    def sname(sid):
        return sections.get(str(sid or ""), {}).get("name", "-")

    items = [i for i in store["items"].values() if not i.get("checked")]

    # --- meta.json : id → name maps, so an agent never needs store.json ---
    meta = {
        "synced_at": store.get("synced_at"),
        "user": {
            "name": store.get("user", {}).get("full_name"),
            "tz": (store.get("user", {}).get("tz_info") or {}).get("timezone"),
            "daily_goal": store.get("user", {}).get("daily_goal"),
        },
        "projects": {str(p["id"]): p.get("name") for p in projects.values()},
        "sections": {str(s["id"]): {"name": s.get("name"), "project": str(s.get("project_id"))}
                     for s in sections.values()},
        "labels": sorted({l.get("name") for l in store["labels"].values() if l.get("name")}),
        "counts": {"active_tasks": len(items), "projects": len(projects)},
    }
    with open(os.path.join(DATA, "meta.json"), "w") as fh:
        json.dump(meta, fh, indent=1, ensure_ascii=False)

    # --- tasks.tsv : one greppable line per task, descriptions stripped ---
    rows = []
    for i in items:
        content = " ".join((i.get("content") or "").split())
        rec = (i.get("due") or {}).get("string", "") if (i.get("due") or {}).get("is_recurring") else ""
        rows.append([
            str(i["id"]),
            pname(i.get("project_id")),
            sname(i.get("section_id")),
            "p%d" % pri_ui(i),
            due_date(i) or "",
            rec,
            ",".join(i.get("labels") or []),
            str(i.get("parent_id") or ""),
            "Y" if (i.get("description") or "").strip() else "",
            content,
        ])
    rows.sort(key=lambda r: (r[4] == "", r[4], r[1], r[2]))
    with open(os.path.join(DATA, "tasks.tsv"), "w") as fh:
        fh.write("id\tproject\tsection\tpri\tdue\trecur\tlabels\tparent\tnote\tcontent\n")
        for r in rows:
            fh.write("\t".join(r) + "\n")

    # --- notes/<id>.md : long descriptions, read only on demand ---
    keep = set()
    for i in items:
        desc = (i.get("description") or "").strip()
        if not desc:
            continue
        keep.add(str(i["id"]) + ".md")
        path = os.path.join(NOTES, str(i["id"]) + ".md")
        body = "# %s\n\n_%s › %s_\n\n%s\n" % (
            " ".join((i.get("content") or "").split()),
            pname(i.get("project_id")), sname(i.get("section_id")), desc)
        if not os.path.exists(path) or open(path).read() != body:
            with open(path, "w") as fh:
                fh.write(body)
    for fn in os.listdir(NOTES):
        if fn.endswith(".md") and fn not in keep:
            os.remove(os.path.join(NOTES, fn))

    render_brief(store, items, pname, sname)


def render_brief(store, items, pname, sname, days=7):
    t = today()
    horizon = t + timedelta(days=days)

    overdue, due_today, soon, undated_p1 = [], [], [], []
    for i in items:
        d = due_date(i)
        if d:
            dd = datetime.strptime(d, "%Y-%m-%d").date()
            if dd < t:
                overdue.append((dd, i))
            elif dd == t:
                due_today.append((dd, i))
            elif dd <= horizon:
                soon.append((dd, i))
        elif pri_ui(i) == 1:
            undated_p1.append((None, i))

    def line(dd, i):
        bits = []
        if dd:
            bits.append(dd.isoformat())
        bits.append("p%d" % pri_ui(i))
        bits.append("[%s]" % pname(i.get("project_id")))
        c = " ".join((i.get("content") or "").split())
        if len(c) > 96:
            c = c[:93] + "..."
        bits.append(c)
        bits.append("(%s)" % i["id"])
        return "- " + " ".join(bits)

    out = []
    out.append("# Brief — %s" % t.isoformat())
    u = store.get("user", {})
    out.append("")
    out.append("_%s · %s · synced %s · %d active tasks_" % (
        u.get("full_name", "?"),
        (u.get("tz_info") or {}).get("timezone", "?"),
        (store.get("synced_at") or "never")[:16],
        len(items)))
    out.append("")
    out.append("> Read this first. For anything more, grep `data/tasks.tsv`.")
    out.append("> Task descriptions live in `data/notes/<id>.md` — open only when needed.")

    for title, group in (
        ("Overdue", sorted(overdue)),
        ("Due today", sorted(due_today)),
        ("Next %d days" % days, sorted(soon)),
        ("Undated p1", undated_p1),
    ):
        out.append("")
        out.append("## %s (%d)" % (title, len(group)))
        if not group:
            out.append("")
            out.append("_none_")
        else:
            out.append("")
            for dd, i in group:
                out.append(line(dd, i))

    # goals carrying no dated action — the failure mode found in the audit
    kids = {}
    for i in items:
        if i.get("parent_id"):
            kids.setdefault(str(i["parent_id"]), []).append(i)
    stalled = []
    for i in items:
        c = i.get("content") or ""
        if not c.lstrip("* ").startswith("As a") and "I want to" not in c:
            continue
        children = kids.get(str(i["id"]), [])
        if not any(due_date(k) for k in children):
            stalled.append(i)
    out.append("")
    out.append("## Goals with no dated next action (%d)" % len(stalled))
    out.append("")
    if not stalled:
        out.append("_none_")
    for i in stalled:
        c = " ".join((i.get("content") or "").split()).lstrip("* ")
        if len(c) > 88:
            c = c[:85] + "..."
        out.append("- [%s] %s (%s)" % (pname(i.get("project_id")), c, i["id"]))
    out.append("")

    with open(os.path.join(DATA, "brief.md"), "w") as fh:
        fh.write("\n".join(out))


def cmd_brief(args):
    store = load_store()
    if not store["items"]:
        die("no local cache — run `todoist sync` first.")
    items = [i for i in store["items"].values() if not i.get("checked")]
    projects, sections = store["projects"], store["sections"]
    path = os.path.join(DATA, "brief.md")
    if args.days == 7:
        render_brief(store, items,
                     lambda pid: projects.get(str(pid or ""), {}).get("name", "-"),
                     lambda sid: sections.get(str(sid or ""), {}).get("name", "-"))
        sys.stdout.write(open(path).read())
    else:
        # non-default horizon: render to a temp view, leave the committed one alone
        real, globals()["DATA"] = DATA, os.path.join(DATA, ".scratch")
        os.makedirs(DATA, exist_ok=True)
        render_brief(store, items,
                     lambda pid: projects.get(str(pid or ""), {}).get("name", "-"),
                     lambda sid: sections.get(str(sid or ""), {}).get("name", "-"),
                     days=args.days)
        sys.stdout.write(open(os.path.join(DATA, "brief.md")).read())
        globals()["DATA"] = real


# --------------------------------------------------------------- read cmds

def cmd_ls(args):
    store = load_store()
    projects, sections = store["projects"], store["sections"]
    t = today()
    rows = []
    for i in store["items"].values():
        if i.get("checked"):
            continue
        d = due_date(i)
        dd = datetime.strptime(d, "%Y-%m-%d").date() if d else None
        if args.overdue and not (dd and dd < t):
            continue
        if args.today and not (dd and dd == t):
            continue
        if args.days is not None and not (dd and t <= dd <= t + timedelta(days=args.days)):
            continue
        if args.project and args.project.lower() not in projects.get(
                str(i.get("project_id") or ""), {}).get("name", "").lower():
            continue
        if args.label and args.label not in (i.get("labels") or []):
            continue
        if args.pri and pri_ui(i) != args.pri:
            continue
        if args.search and args.search.lower() not in (i.get("content") or "").lower():
            continue
        rows.append((d or "9999", i))
    for d, i in sorted(rows, key=lambda r: r[0]):
        print("%-20s %-10s p%d  %-14s %s" % (
            i["id"], (d if d != "9999" else "-"), pri_ui(i),
            projects.get(str(i.get("project_id") or ""), {}).get("name", "-")[:14],
            " ".join((i.get("content") or "").split())[:80]))
    print("\n%d task(s)" % len(rows), file=sys.stderr)


def cmd_show(args):
    store = load_store()
    for tid in args.ids:
        i = store["items"].get(str(tid))
        if not i:
            print("%s: not found" % tid, file=sys.stderr)
            continue
        p = store["projects"].get(str(i.get("project_id") or ""), {})
        s = store["sections"].get(str(i.get("section_id") or ""), {})
        print("=" * 72)
        print(i.get("content"))
        print("-" * 72)
        print("id       %s" % i["id"])
        print("project  %s / %s" % (p.get("name", "-"), s.get("name", "-")))
        print("priority p%d" % pri_ui(i))
        due = i.get("due") or {}
        print("due      %s%s" % (due.get("string", "-"),
                                 "  [recurring]" if due.get("is_recurring") else ""))
        print("labels   %s" % (", ".join(i.get("labels") or []) or "-"))
        print("parent   %s" % (i.get("parent_id") or "-"))
        desc = (i.get("description") or "").strip()
        if desc:
            print("-" * 72)
            print(desc)
        print()


def cmd_projects(args):
    store = load_store()
    secs = {}
    for s in store["sections"].values():
        secs.setdefault(str(s.get("project_id")), []).append(s)
    for p in sorted(store["projects"].values(), key=lambda x: x.get("child_order", 0)):
        print("%-20s %s" % (p["id"], p.get("name")))
        for s in sorted(secs.get(str(p["id"]), []), key=lambda x: x.get("section_order", 0)):
            print("  %-18s %s" % (s["id"], s.get("name")))


# -------------------------------------------------------------- write cmds

def commands(cmds):
    """Send a batch of Sync API commands, then refresh the local cache."""
    res = post("/sync", {"commands": json.dumps(cmds)})
    status = res.get("sync_status", {})
    bad = {k: v for k, v in status.items() if v != "ok"}
    if bad:
        die("some commands failed: %s" % json.dumps(bad, indent=1))
    return res


def uid(n=0):
    return "%d-%d" % (int(time.time() * 1000), n)


def resolve_project(store, name):
    if not name:
        return None
    for p in store["projects"].values():
        if str(p["id"]) == name or name.lower() in (p.get("name") or "").lower():
            return str(p["id"])
    die("no project matching %r" % name)


def resolve_section(store, name):
    if not name:
        return None
    for s in store["sections"].values():
        if str(s["id"]) == name or name.lower() in (s.get("name") or "").lower():
            return str(s["id"])
    die("no section matching %r" % name)


def cmd_add(args):
    store = load_store()
    item = {"content": args.content}
    if args.desc:
        item["description"] = args.desc
    if args.due:
        item["due"] = {"string": args.due}
    if args.pri:
        item["priority"] = UI2API[args.pri]
    if args.project:
        item["project_id"] = resolve_project(store, args.project)
    if args.section:
        item["section_id"] = resolve_section(store, args.section)
    if args.parent:
        item["parent_id"] = str(args.parent)
    if args.label:
        item["labels"] = args.label
    commands([{"type": "item_add", "uuid": uid(), "temp_id": uid(1), "args": item}])
    print("added: %s" % args.content)
    cmd_sync(argparse.Namespace(full=False))


def cmd_done(args):
    # item_close, not item_complete: on a recurring task it advances to the next
    # occurrence instead of killing the series. On a normal task it just completes.
    commands([{"type": "item_close", "uuid": uid(n), "args": {"id": str(i)}}
              for n, i in enumerate(args.ids)])
    print("closed %d task(s)" % len(args.ids))
    cmd_sync(argparse.Namespace(full=False))


def cmd_resched(args):
    store = load_store()
    item = store["items"].get(str(args.id))
    if item and (item.get("due") or {}).get("is_recurring") and not args.force:
        if "every" not in args.due.lower():
            die("%s is recurring (%r). Setting a plain date would destroy the\n"
                "recurrence. Either pass a recurring string, or re-run with --force\n"
                "if you really mean to make it one-off."
                % (args.id, (item.get("due") or {}).get("string")))
    commands([{"type": "item_update", "uuid": uid(),
               "args": {"id": str(args.id), "due": {"string": args.due}}}])
    print("%s → %s" % (args.id, args.due))
    cmd_sync(argparse.Namespace(full=False))


def cmd_pri(args):
    commands([{"type": "item_update", "uuid": uid(),
               "args": {"id": str(args.id), "priority": UI2API[args.level]}}])
    print("%s → p%d" % (args.id, args.level))
    cmd_sync(argparse.Namespace(full=False))


def cmd_rm(args):
    commands([{"type": "item_delete", "uuid": uid(n), "args": {"id": str(i)}}
              for n, i in enumerate(args.ids)])
    print("deleted %d task(s)" % len(args.ids))
    cmd_sync(argparse.Namespace(full=False))


# ------------------------------------------------------------------ doctor

def cmd_doctor(args):
    ok = True
    print("python       %s" % sys.version.split()[0])
    tok = os.environ.get("TODOIST_API_TOKEN") or os.environ.get("TODOIST_API_KEY")
    if tok:
        print("token        env (%s…)" % tok[:6])
    elif os.path.exists(os.path.join(ROOT, ".env")):
        print("token        .env file")
    else:
        print("token        MISSING — export TODOIST_API_TOKEN=...")
        ok = False
    if os.environ.get("SSL_CERT_FILE"):
        print("ca bundle    %s" % os.environ["SSL_CERT_FILE"])
    if os.environ.get("HTTPS_PROXY"):
        print("proxy        %s" % os.environ["HTTPS_PROXY"])
    if os.path.exists(STORE):
        store = load_store()
        age = "never"
        if store.get("synced_at"):
            delta = datetime.now(timezone.utc) - datetime.fromisoformat(store["synced_at"])
            age = "%dh %dm ago" % (delta.seconds // 3600 + delta.days * 24,
                                   (delta.seconds % 3600) // 60)
        print("cache        %d tasks, synced %s" % (
            len([i for i in store["items"].values() if not i.get("checked")]), age))
    else:
        print("cache        empty — run `todoist sync`")
    for f in ("brief.md", "tasks.tsv", "meta.json"):
        p = os.path.join(DATA, f)
        print("%-12s %s" % (f, ("%d bytes" % os.path.getsize(p)) if os.path.exists(p) else "missing"))
    if ok and tok:
        try:
            post("/sync", {"sync_token": "*", "resource_types": json.dumps(["user"])})
            print("api          reachable")
        except SystemExit:
            ok = False
    sys.exit(0 if ok else 1)


# -------------------------------------------------------------------- main

def main():
    ap = argparse.ArgumentParser(prog="todoist", description=__doc__,
                                 formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = ap.add_subparsers(dest="cmd", required=True)

    s = sub.add_parser("sync"); s.add_argument("--full", action="store_true"); s.set_defaults(fn=cmd_sync)
    s = sub.add_parser("brief"); s.add_argument("--days", type=int, default=7); s.set_defaults(fn=cmd_brief)

    s = sub.add_parser("ls")
    s.add_argument("--overdue", action="store_true")
    s.add_argument("--today", action="store_true")
    s.add_argument("--days", type=int)
    s.add_argument("--project"); s.add_argument("--label")
    s.add_argument("--pri", type=int, choices=[1, 2, 3, 4]); s.add_argument("--search")
    s.set_defaults(fn=cmd_ls)

    s = sub.add_parser("show"); s.add_argument("ids", nargs="+"); s.set_defaults(fn=cmd_show)
    s = sub.add_parser("projects"); s.set_defaults(fn=cmd_projects)

    s = sub.add_parser("add")
    s.add_argument("content")
    s.add_argument("--due"); s.add_argument("--pri", type=int, choices=[1, 2, 3, 4])
    s.add_argument("--project"); s.add_argument("--section"); s.add_argument("--parent")
    s.add_argument("--label", action="append"); s.add_argument("--desc")
    s.set_defaults(fn=cmd_add)

    s = sub.add_parser("done"); s.add_argument("ids", nargs="+"); s.set_defaults(fn=cmd_done)
    s = sub.add_parser("resched"); s.add_argument("id"); s.add_argument("due")
    s.add_argument("--force", action="store_true", help="allow dropping a recurrence")
    s.set_defaults(fn=cmd_resched)
    s = sub.add_parser("pri"); s.add_argument("id"); s.add_argument("level", type=int, choices=[1, 2, 3, 4]); s.set_defaults(fn=cmd_pri)
    s = sub.add_parser("rm"); s.add_argument("ids", nargs="+"); s.set_defaults(fn=cmd_rm)
    s = sub.add_parser("doctor"); s.set_defaults(fn=cmd_doctor)

    args = ap.parse_args()
    args.fn(args)


if __name__ == "__main__":
    main()
