# Todoist -> Settings -> Integrations -> Developer -> API token
# bin/setup copies this into ~/.config/todoist/config.json (never into the repo)
TODOIST_API_TOKEN=

# Optional. Leave blank and run `dbxcli login` once instead — that saves
# refreshable OAuth credentials, which is the better option for a laptop.
# A raw token here is only useful for CI or a headless box.
DROPBOX_ACCESS_TOKEN=

# Only needed behind a TLS-inspecting corporate proxy
# SSL_CERT_FILE=/path/to/ca-bundle.crt
